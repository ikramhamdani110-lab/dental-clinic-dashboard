{
  "name": "sahed-dental-clinic",
  "version": "1.0.0",
  "private": true,
  "description": "Systeme de gestion de cabinet dentaire - Sahed Dental Clinic",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:demo": "node scripts/demo-env.mjs next dev -p 3000",
    "build": "prisma generate --schema database/prisma/schema.prisma && next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema database/prisma/schema.prisma",
    "db:seed": "tsx database/seed.ts",
    "db:seed:demo": "node scripts/demo-env.mjs tsx database/seed-demo.ts",
    "db:demo:start": "node scripts/demo-db.mjs start",
    "db:demo:stop": "node scripts/demo-db.mjs stop",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup:postgres": "node database/scripts/backup-postgres.mjs",
    "corbeille:purger": "node database/scripts/purge-corbeille.mjs",
    "desktop:build": "cross-env BUILD_TARGET=desktop next build && node desktop/prepare.mjs",
    "desktop:start": "node desktop/dev-launch.mjs",
    "desktop:installer": "electron-builder --config electron-builder.config.cjs",
    "prebuild": "node scripts/copier-polices.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "@types/pdfkit": "^0.17.6",
    "argon2": "0.41.1",
    "date-fns": "4.1.0",
    "file-type": "19.6.0",
    "jose": "5.9.6",
    "next": "15.5.25",
    "pdfkit": "^0.20.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-is": "19.1.0",
    "recharts": "2.15.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "chrome-launcher": "^1.2.2",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "lighthouse": "^13.5.0",
    "prettier": "3.4.2",
    "prisma": "6.1.0",
    "puppeteer-core": "^25.15.0",
    "tsx": "4.20.3",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
