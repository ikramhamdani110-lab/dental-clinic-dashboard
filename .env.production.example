# =============================================================================
#  EXEMPLE DE CONFIGURATION — PRODUCTION (HTTPS)
# =============================================================================
#
#  Ne contient AUCUN secret reel : les valeurs sensibles sont a remplacer par
#  celles du cabinet. Ne jamais committer un fichier contenant de vrais secrets.
#
#  Ce fichier documente la configuration CORRECTE pour une mise en production
#  servie en HTTPS. La validation `backend/config/env.ts` refuse de demarrer en
#  production si `COOKIE_SECURE` n'est pas "true" ou si `SESSION_SECRET` manque.
# =============================================================================

NODE_ENV="production"

# URL publique en HTTPS OBLIGATOIRE (les cookies Secure ne sont transmis qu'en HTTPS).
APP_URL="https://cabinet.example.tld"

# Cookie : transmis uniquement par HTTPS. JAMAIS "false" en production.
COOKIE_SECURE="true"

# Domaine du cookie : le domaine public reel du cabinet (sans schema).
COOKIE_DOMAIN="cabinet.example.tld"

# Base de donnees : TLS obligatoire + pool borne.
DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://sahed_app:MOT_DE_PASSE_FORT@db.example.tld:5432/sahed_clinic?schema=public&sslmode=require&connection_limit=10&pool_timeout=20"

# Secrets SERVEUR (generes cote cabinet, jamais partages, jamais committes).
# SESSION_SECRET : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
PASSWORD_PEPPER=""

# Stockage prive des documents, hors racine web.
DOCUMENTS_STORAGE_PATH="/var/lib/sahed/documents"
DOCUMENTS_MAX_BYTES="20971520"

LOG_LEVEL="info"

# Note : le compte medecin initial est cree par `npm run db:seed` a partir de
# DOCTOR_EMAIL / DOCTOR_NAME / DOCTOR_INITIAL_PASSWORD, puis le mot de passe
# doit etre change depuis l'application.