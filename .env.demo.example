# ─────────────────────────────────────────────────────────────────────────────
#  ENVIRONNEMENT DE DEMONSTRATION
# ─────────────────────────────────────────────────────────────────────────────
#
#  Ce fichier ne contient AUCUN secret : ni mot de passe de production, ni cle de
#  session. Seuls l'URL de la base de demonstration et celle de l'application y
#  figurent, avec un mot de passe de demonstration sans valeur.
#
#  La base de demonstration est un cluster PostgreSQL SEPARE (voir `.demo-pg/`),
#  qui ecoute sur le port 5433. La base du cabinet reste sur le port 5432 et n'est
#  jamais atteinte par ces commandes : `scripts/demo-env.mjs` refuse de demarrer
#  si l'URL ne designate pas explicitement `sahed_demo_clinic` sur le port 5433.
#
#  Aucune de ces variables n'est lue par `npm run dev` ni `npm run build`
#  standards : elles ne servent qu'aux scripts `npm run *:demo`.
# ─────────────────────────────────────────────────────────────────────────────

# Instance de demonstration (cluster separe, port 5433).
DATABASE_URL_DEMO="postgresql://sahed_demo:sahed_demo_2026@127.0.0.1:5433/sahed_demo_clinic"

# Application servie pour la demonstration.
APP_URL_DEMO="http://localhost:3000"
