# Variables d'environnement — SAHED DENTAL CLINIC
# Copier ce fichier vers `.env` puis renseigner les valeurs reelles.
# NE JAMAIS COMMITTER `.env`.

# ─────────────────────────────────────────────────────────────────────────────
#  BASE DE DONNEES
# ─────────────────────────────────────────────────────────────────────────────

# Fournisseur Prisma.
#   postgresql = PRODUCTION ET DEVELOPPEMENT (source de verite unique).
#
# NOTE D'ARCHITECTURE : une variante SQLite locale a ete retiree du projet.
# SQLite ne supporte ni les enums natifs ni la recherche insensible a la casse,
# ce qui faisait diverger le comportement observe du comportement de production.
# Le systeme cible desormais PostgreSQL uniquement : ce qui est verifie est
# exactement ce qui sera execute en production.
DATABASE_PROVIDER="postgresql"

# Chaine de connexion PostgreSQL (obligatoire).
# Developpement local :
# DATABASE_URL="postgresql://sahed_app:motdepasse@localhost:5432/sahed_clinic?schema=public"
# Production (TLS obligatoire) :
# DATABASE_URL="postgresql://sahed_app:MOT_DE_PASSE_FORT@db.example.tld:5432/sahed_clinic?schema=public&sslmode=require&connection_limit=10&pool_timeout=20"
DATABASE_URL=""

# ─────────────────────────────────────────────────────────────────────────────
#  SECURITE — SECRETS SERVEUR (jamais exposes au navigateur)
# ─────────────────────────────────────────────────────────────────────────────

# Secret de signature des cookies / jetons internes. 32 octets minimum.
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Secret de politique de hachage Argon2id. Permet de changer les parametres sans
# invalider les empreintes existantes (rehachage a la connexion).
PASSWORD_PEPPER=""

# ─────────────────────────────────────────────────────────────────────────────
#  ENVIRONNEMENT
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV="development"

# URL publique de l'application — utilisee pour SameSite/CORS et les redirections.
# En production : https://... (HTTPS obligatoire).
APP_URL="http://localhost:3000"

# Domaine des cookies. Laisser vide en developpement (cookie d'hote).
COOKIE_DOMAIN=""

# En production HTTPS, mettre "true" : les cookies ne circulent qu'en HTTPS.
# Developpement local en http:// : "false" (un cookie Secure serait ignore par
# le navigateur). La validation du demarrage REFUSE "false" lorsque
# NODE_ENV=production : c'est un garde-fou, ne le contournez pas.
COOKIE_SECURE="false"

# ─────────────────────────────────────────────────────────────────────────────
#  COMPTE MEDECIN INITIAL (utilise par database/seed.ts, jamais par l'application)
# ─────────────────────────────────────────────────────────────────────────────

DOCTOR_EMAIL=""
DOCTOR_NAME=""
DOCTOR_INITIAL_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
#  STOCKAGE DES DOCUMENTS (hors racine web)
# ─────────────────────────────────────────────────────────────────────────────

# Chemin absolu d'un repertoire prive, NON servi par le serveur web.
DOCUMENTS_STORAGE_PATH=""

# Taille maximale d'un document, en octets (defaut : 20 Mo).
DOCUMENTS_MAX_BYTES="20971520"

# ─────────────────────────────────────────────────────────────────────────────
#  JOURNALISATION
# ─────────────────────────────────────────────────────────────────────────────

# debug | info | warn | error
LOG_LEVEL="info"