// =============================================================================
//  SAHED DENTAL CLINIC — SCHEMA PRISMA (PRODUCTION)
// =============================================================================
//
//  ATTENTION — LECTURE OBLIGATOIRE
//
//  Ce schema est concu POUR POSTGRESQL. PostgreSQL est la SEULE source de verite,
//  en developpement comme en production.
//
//  NOTE D'ARCHITECTURE
//    Une variante SQLite locale existait pour executer l'application sur une
//    machine depourvue de PostgreSQL. Elle a ete RETIREE : SQLite ne supporte ni
//    les enums natifs ni la recherche insensible a la casse (`mode:
//    'insensitive'`), ce qui faisait diverger le comportement observe du
//    comportement de production. Cibler PostgreSQL uniquement garantit que ce
//    qui est verifie est exactement ce qui sera execute.
//
//  Contraintes propres a PostgreSQL (index partiels, CHECK, trigram, unicite
//  insensible a la casse) : elles vivent dans la migration
//  `database/prisma/migrations/20250101000001_postgresql_integrity/`.
//  Voir `docs/DATABASE.md` et `docs/POSTGRESQL-VERIFICATION.md`.
//
//  REGLE METIER CENTRALE (§8 de la specification)
//
//    Patient 1 ── n Treatment 1 ── n TreatmentVisit 1 ── n Payment
//
//  Un patient a un nombre illimite de traitements historiques.
//  « Reste a payer » n'est JAMAIS stocke : il est toujours calcule a partir
//  de la somme des paiements valides.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
//  UTILISATEURS & SESSIONS
// -----------------------------------------------------------------------------

/// Le medecin (et, plus tard, d'eventuels roles supplementaires).
/// V1 n'expose que le role MEDECIN. L'enumeration existe des maintenant pour
/// que la couche d'autorisation n'ait pas a etre reconstruite plus tard.
enum UserRole {
  MEDECIN
  /// Reserve pour une evolution future — non active en V1.
  ASSISTANT
  ADMINISTRATEUR
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String
  role        UserRole @default(MEDECIN)

  /// Empreinte Argon2id. Jamais exposee, jamais renvoyee par l'API.
  passwordHash String

  isActive Boolean @default(true)

  /// Compteur d'echecs consecutifs — base de la protection anti-force brute.
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          Session[]
  activityLogs      ActivityLog[]
  createdPayments   Payment[]               @relation("PaymentCreatedBy")
  correctedPayments PaymentCorrection[]     @relation("CorrectionCreatedBy")
  medicalRecords    MedicalRecord[]         @relation("MedicalRecordAuthor")
  prescriptions     Prescription[]          @relation("PrescriptionAuthor")
  odontogram        OdontogramEntry[]       @relation("OdontogramAuthor")
  documents         Document[]              @relation("DocumentAuthor")
  reschedules       AppointmentReschedule[] @relation("RescheduleChangedBy")
  appointments      Appointment[]
  trashEntries      TrashEntry[]            @relation("TrashDeletedBy")
  passwordResets    PasswordResetToken[]
  manualIncomes     ManualIncome[]          @relation("ManualIncomeCreatedBy")
  expenses          Expense[]               @relation("ExpenseCreatedBy")
  personalTx        PersonalTransaction[]   @relation("PersonalTransactionCreatedBy")
  financeSessions   FinanceSession[]        @relation("FinanceSessionUser")
  deviceSessions    DeviceSession[]         @relation("DeviceSessionUser")

  @@map("users")
}

/// Session serveur. Le cookie ne contient qu'un jeton opaque ; le secret de
/// session vit uniquement en base, sous forme d'empreinte SHA-256.
model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 du jeton de session. Le jeton en clair n'est jamais stocke.
  tokenHash String @unique

  /// SHA-256 du jeton CSRF associe a la session.
  csrfTokenHash String

  ipAddress String?
  userAgent String?

  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Session DEDIEE au site financier prive du medecin (/finances).
///
/// Volontairement SEPAREE de la session clinique (`sessions`) : le site
/// financier ne peut jamais etre ouvert par la session de l'application de
/// bureau, et reciproquement. Les deux mondes ne partagent AUCUN cookie.
model FinanceSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("FinanceSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 du jeton. Le jeton en clair n'est jamais stocke.
  tokenHash String @unique

  /// SHA-256 du jeton CSRF associe a la session financiere.
  csrfTokenHash String

  ipAddress String?
  userAgent String?

  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([userId])
  @@index([expiresAt])
  @@map("finance_sessions")
}

/// Journal des tentatives de connexion — sert au rate limiting et a l'audit.
model LoginAttempt {
  id         String  @id @default(uuid()) @db.Uuid
  email      String
  ipAddress  String
  successful Boolean @default(false)

  /// Raison technique uniquement, conservee cote serveur. Le message renvoye a
  /// l'interface reste generique (§6).
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

/// Jeton de reinitialisation de mot de passe — courte duree de vie, usage unique.
model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 du jeton. Le jeton en clair n'est transmis qu'une seule fois.
  tokenHash String @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
//  PATIENTS
// -----------------------------------------------------------------------------
//  L'identifiant interne (UUID) n'est JAMAIS affiche dans l'interface (§48).
//  Les patients sont recherches par Nom, Prenom et Telephone (§7).

enum Sexe {
  MASCULIN
  FEMININ
  NON_PRECISE
}

model Patient {
  id String @id @default(uuid()) @db.Uuid

  nom    String
  prenom String

  /// Age en annees revolues, saisi au cabinet.
  ///
  ///  POURQUOI UNE COLONNE DEDIEE
  ///    Le medecin enregistre l'age, pas une date de naissance : la date de
  ///    naissance n'est pas un champ du formulaire. Stocker l'age permet de
  ///    creer et de modifier un patient sans exiger une date de naissance.
  ///
  ///  `dateNaissance` est CONSERVEE : les patients deja enregistres la
  ///    possedent, et elle reste la donnee la plus precise lorsqu'elle est
  ///    connue. L'age saisi prime pour l'affichage ; a defaut, l'age est
  ///    calcule depuis la date de naissance (voir `lib/age`).
  age Int?

  dateNaissance DateTime?
  sexe          Sexe      @default(NON_PRECISE)

  telephone           String
  telephoneSecondaire String?

  adresse String?
  email   String?

  allergies           String?
  antecedentsMedicaux String?
  medicamentsActuels  String?
  contactUrgence      String?
  notesGenerales      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  treatments     Treatment[]
  payments       Payment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  odontogram     OdontogramEntry[]
  documents      Document[]

  @@index([nom, prenom])
  @@index([prenom, nom])
  @@index([telephone])
  @@index([createdAt])
  @@map("patients")
}

// -----------------------------------------------------------------------------
//  TRAITEMENTS & VISITES  (Patient ── n Treatment ── n TreatmentVisit)
// -----------------------------------------------------------------------------

enum StatutTraitement {
  PLANIFIE
  EN_COURS
  TERMINE
  ANNULE
}

model Treatment {
  id String @id @default(uuid()) @db.Uuid

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  typeTraitement String

  /// Dents au format FDI, stockees en liste JSON (ex. ["36","37"]).
  /// Regroupees par 2 chiffres, denture permanente 11..48 et temporaire 51..85.
  dents String @default("[]")

  diagnostic  String?
  description String?

  /// Prix total en CENTIMES. Les montants ne sont jamais stockes en flottant.
  prixTotalCentimes Int

  statut StatutTraitement @default(PLANIFIE)

  /// Statut de synchronisation (sync). `A_ARBITRER` = conflit non résolu :
  /// traitement verrouillé en lecture seule jusqu'à arbitrage médecin.
  syncStatut String @default("VALIDE")

  dateDebut DateTime?
  dateFin   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits         TreatmentVisit[]
  payments       Payment[]
  appointments   Appointment[]
  prescriptions  Prescription[]
  odontogram     OdontogramEntry[]
  medicalRecords MedicalRecord[]

  /// « Reste a payer » et « montant paye » ne figurent volontairement PAS ici :
  /// ils sont calcules depuis les paiements valides (§12, §17).
  @@index([patientId, statut])
  @@index([patientId, dateDebut])
  @@index([statut])
  @@map("treatments")
}

/// Une visite = une seance. Un traitement peut comporter plusieurs visites.
/// Exemple : une devitalisation = 1 traitement / 3 visites (§13).
model TreatmentVisit {
  id String @id @default(uuid()) @db.Uuid

  treatmentId String    @db.Uuid
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  /// Numero de seance (1, 2, 3...) pour l'affichage chronologique.
  numeroSeance Int
  dateDebut    DateTime
  dateFin      DateTime?

  notes               String?
  proceduresRealisees String?

  /// Rendez-vous associe, lorsqu'une visite provient d'un rendez-vous.
  appointmentId String?      @unique @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@unique([treatmentId, numeroSeance])
  @@index([treatmentId, dateDebut])
  @@map("treatment_visits")
}

// -----------------------------------------------------------------------------
//  RENDEZ-VOUS & REPROGRAMMATION
// -----------------------------------------------------------------------------

enum StatutRendezVous {
  PLANIFIE
  CONFIRME
  EN_ATTENTE
  EN_COURS
  TERMINE
  ANNULE
  ABSENT
  REPROGRAMME
}

model Appointment {
  id String @id @default(uuid()) @db.Uuid

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// Praticien. V1 = un seul medecin ; la colonne existe pour un futur cabinet
  /// a plusieurs praticiens sans reconstruire le modele.
  praticienId String? @db.Uuid
  praticien   User?   @relation(fields: [praticienId], references: [id], onDelete: SetNull)

  treatmentId String?    @db.Uuid
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  dateDebut DateTime
  dateFin   DateTime

  dents String @default("[]")

  motif String?
  notes String?

  /// Cle d'idempotence du nouveau formulaire de rendez-vous.
  submissionKey String? @unique

  statut StatutRendezVous @default(PLANIFIE)

  /// Statut de synchronisation (sync). `CONFLIT_A_ARBITRER` = le push de ce
  /// RDV a ete rejete pour chevauchement de creneau et attend un arbitrage
  /// humain (voir migration 20261101000000 et PLAN-SYNC-OFFLINE-B.md §1.5bis).
  syncStatut String @default("VALIDE")

  /// Intervalle tstzrange demi-ouvert '[dateDebut, dateFin)' recalculé par un
  /// déclencheur PostgreSQL (voir migration 20261101000000). Utilisé par la
  /// contrainte d'exclusion anti-chevauchement. Prisma ne gère pas les
  /// colonnes maintenues par déclencheur : lue mais jamais écrite.
  creneau String? @ignore

  /// Motif d'annulation / d'absence, conserve pour l'historique.
  motifStatut String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit       TreatmentVisit?
  reschedules AppointmentReschedule[]

  @@index([dateDebut])
  @@index([patientId, dateDebut])
  @@index([statut, dateDebut])
  @@index([treatmentId])
  @@map("appointments")
}

/// Historique de reprogrammation. Chaque reprogrammation AJOUTE une ligne ;
/// l'historique precedent n'est jamais ecrase (§15, §11).
model AppointmentReschedule {
  id String @id @default(uuid()) @db.Uuid

  appointmentId String      @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  ancienneDateDebut DateTime
  ancienneDateFin   DateTime
  nouvelleDateDebut DateTime
  nouvelleDateFin   DateTime

  motif String?

  /// Qui a effectue le changement, et quand.
  modifieParId String? @db.Uuid
  modifiePar   User?   @relation("RescheduleChangedBy", fields: [modifieParId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([appointmentId, createdAt])
  @@map("appointment_reschedules")
}

// -----------------------------------------------------------------------------
//  PAIEMENTS — evenements financiers historiques
// -----------------------------------------------------------------------------
//  Un paiement n'est JAMAIS modifie ni supprime silencieusement.
//  Toute correction passe par PaymentCorrection (annulation / contre-passation).

enum MethodePaiement {
  ESPECES
  CARTE
  VIREMENT
  AUTRE
}

enum StatutPaiement {
  /// Paiement valide : compte dans les totaux.
  VALIDE
  /// Annule par contre-passation : exclu des totaux, conserve pour l'audit.
  ANNULE
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  ///
  /// TRAITEMENT LIÉ — DÉSORMAIS NULLABLE (§paiements-avance, §secretaire-v2).
  ///
  /// `null` = ACOMPTE : argent réellement reçu par le cabinet AVANT tout
  /// traitement. Il appartient au PATIENT (crédit), pas à un soin. Il n'est
  /// jamais converti en « faux traitement » — la caisse reste exacte.
  ///
  /// Rattachement ultérieur (affectation à un traitement) se fait par une
  /// opérion explicite et TRAÇABLE : on écrit le nouveau `treatmentId` dans
  /// la ligne EXISTANTE, sans créer un second paiement — l'argent ne peut
  /// donc jamais être compté deux fois.
  ///
  treatmentId String?    @db.Uuid
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: Restrict)

  /// Visite concernee, lorsqu'elle est connue (§13, §16).
  treatmentVisitId String?         @db.Uuid
  treatmentVisit   TreatmentVisit? @relation(fields: [treatmentVisitId], references: [id], onDelete: SetNull)

  /// Montant en centimes. Toujours strictement positif (verifie cote serveur).
  montantCentimes Int

  datePaiement DateTime

  /// Methode d'encaissement. Conservee en base pour l'architecture existante,
  /// mais NON exposee dans l'interface (§16). Une valeur par defaut permet de
  /// creer un paiement sans que le client ait a la fournir : aucune migration
  /// destructrice, le champ n'est simplement plus demande.
  methode MethodePaiement @default(ESPECES)
  statut  StatutPaiement  @default(VALIDE)

  /// Statut de synchronisation (sync). `VALIDE` par defaut ; `A_ARBITRER`
  /// signifie que ce paiement est en conflit de synchronisation et qu'il est
  /// EXCLU de tous les calculs financiers jusqu'a resolution (voir
  /// backend/services/finances.service.ts). Jamais expose au formulaire.
  syncStatut String @default("VALIDE")

  notes String?

  /// Cle d'idempotence fournie par le client : empeche la double soumission
  /// d'un meme paiement (§17). Unique en base.
  idempotencyKey String @unique

  /// Renseigne lorsque le paiement resulte d'une correction (contre-passation).
  sourceCorrectionId String? @unique @db.Uuid

  createdById String @db.Uuid
  createdBy   User   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  corrections PaymentCorrection[]

  @@index([patientId, datePaiement])
  @@index([treatmentId, statut])
  @@index([datePaiement, statut])
  @@index([statut])
  @@map("payments")
}

enum TypeCorrectionPaiement {
  /// Le paiement devient nul : une contre-passation de signe oppose est creee.
  ANNULATION
  /// Correction de montant : le paiement est annule et un nouveau est cree.
  CORRECTION_MONTANT
  /// Correction de la methode ou de la date uniquement.
  CORRECTION_ATTRIBUT
}

model PaymentCorrection {
  id String @id @default(uuid()) @db.Uuid

  /// Paiement d'origine corrige.
  paymentId String  @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  type TypeCorrectionPaiement

  motif String

  /// Valeurs avant correction, conservees pour l'audit.
  ancienMontantCentimes Int
  ancienneMethode       MethodePaiement
  ancienneDate          DateTime

  nouveauMontantCentimes Int?
  nouvelleMethode        MethodePaiement?
  nouvelleDate           DateTime?

  createdById String @db.Uuid
  createdBy   User   @relation("CorrectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
  @@map("payment_corrections")
}

// -----------------------------------------------------------------------------
//  DOSSIER MEDICAL — entrees historiques, jamais un champ unique ecrasable (§19)
// -----------------------------------------------------------------------------

model MedicalRecord {
  id String @id @default(uuid()) @db.Uuid

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  treatmentId String?    @db.Uuid
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  date DateTime

  motifPlainte      String?
  examen            String?
  diagnostic        String?
  traitementRealise String?
  observations      String?
  recommandations   String?
  dateSuivi         DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("MedicalRecordAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, date])
  @@map("medical_records")
}

// -----------------------------------------------------------------------------
//  ORDONNANCES — numerique uniquement, AUCUN PDF (§21, §45)
// -----------------------------------------------------------------------------

model Prescription {
  id String @id @default(uuid()) @db.Uuid

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  treatmentId String?    @db.Uuid
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  date DateTime

  notes String?

  /// Cle d'idempotence du generateur d'ordonnance (anti double soumission).
  /// Meme mecanique que `Appointment.submissionKey` : le navigateur en genere
  /// une par soumission ; un renvoi du meme formulaire ne cree pas de doublon.
  submissionKey String? @unique

  /// En-tete de clinique utilise lors de la creation (titre arabe, adresse,
  /// telephones, horaires, conseil de pied de page, nom du praticien).
  /// Conserve AVEC l'ordonnance pour qu'une reimpression reproduise
  /// exactement l'en-tete d'origine, meme si ces elements changent ensuite.
  enteteOrdonnance Json?

  createdById String? @db.Uuid
  createdBy   User?   @relation("PrescriptionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PrescriptionItem[]

  @@index([patientId, date])
  @@map("prescriptions")
}

model PrescriptionItem {
  id String @id @default(uuid()) @db.Uuid

  prescriptionId String       @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicament   String
  dosage       String
  frequence    String
  duree        String
  instructions String?
  notes        String?

  position Int @default(0)

  @@index([prescriptionId, position])
  @@map("prescription_items")
}

// -----------------------------------------------------------------------------
//  ODONTOGRAMME FDI — historique par dent, jamais ecrase (§20)
// -----------------------------------------------------------------------------

enum EtatDent {
  SAINE
  CARIE
  OBTUREE
  ABSENTE
  COURONNE
  DEVITALISEE
  EXTRACTION_PREVUE
  IMPLANT
  AUTRE
}

/// Chaque changement d'etat d'une dent AJOUTE une entree.
/// L'etat courant d'une dent = la derniere entree par date.
model OdontogramEntry {
  id String @id @default(uuid()) @db.Uuid

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  treatmentId String?    @db.Uuid
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  /// Identifiant FDI a deux chiffres : 11..18, 21..28, 31..38, 41..48,
  /// ainsi que 51..55, 61..65, 71..75, 81..85 pour la denture temporaire.
  numeroDent String

  etat EtatDent

  commentaire String?
  date        DateTime

  createdById String? @db.Uuid
  createdBy   User?   @relation("OdontogramAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([patientId, numeroDent, date])
  @@map("odontogram_entries")
}

// -----------------------------------------------------------------------------
//  DOCUMENTS — stockage prive, aucune URL publique previsible (§22)
// -----------------------------------------------------------------------------

model Document {
  id String @id @default(uuid()) @db.Uuid

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// Nom de fichier d'origine assaini, affiche au medecin.
  nomOriginal String

  /// Chemin de stockage interne (hors racine web), jamais expose.
  cheminStockage String

  mimeType     String
  tailleOctets Int

  /// SHA-256 du contenu — detection des doublons et verification d'integrite.
  checksumSha256 String

  categorie   String?
  description String?

  createdById String? @db.Uuid
  createdBy   User?   @relation("DocumentAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
  @@map("documents")
}

// -----------------------------------------------------------------------------
//  CORBEILLE — EXACTEMENT 24 HEURES  (§23)
// -----------------------------------------------------------------------------

enum TypeEntiteSupprimable {
  PATIENT
  RENDEZ_VOUS
  TRAITEMENT
  VISITE_TRAITEMENT
  PAIEMENT
  DOSSIER_MEDICAL
  ORDONNANCE
  DOCUMENT
  ENTREE_ODONTOGRAMME
}

model TrashEntry {
  id String @id @default(uuid()) @db.Uuid

  entityType TypeEntiteSupprimable

  /// Identifiant interne de l'entite supprimee (UUID). Jamais affiche.
  entityId String @db.Uuid

  /// Description lisible affichee dans la Corbeille.
  description String

  /// Snapshot JSON des champs necessaires a la restauration.
  snapshot String

  supprimeParId String? @db.Uuid
  supprimePar   User?   @relation("TrashDeletedBy", fields: [supprimeParId], references: [id], onDelete: SetNull)

  supprimeLe DateTime @default(now())

  /// Date limite de restauration = supprimeLe + 24 heures, EXACTEMENT.
  /// La fenetre de 24 h est une constante du domaine, non configurable.
  expireLe DateTime

  restaureLe                  DateTime?
  restaureParId               String?   @db.Uuid
  supprimeDefinitivementLe    DateTime?
  supprimeDefinitivementParId String?   @db.Uuid

  @@unique([entityType, entityId])
  @@index([expireLe])
  @@index([supprimeLe])
  @@index([restaureLe])
  @@map("trash_entries")
}

// -----------------------------------------------------------------------------
//  JOURNAL D'ACTIVITE (§24)
// -----------------------------------------------------------------------------

model ActivityLog {
  id String @id @default(uuid()) @db.Uuid

  action String

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Email conserve meme si l'utilisateur est supprime plus tard.
  userEmail String?

  entityType String?
  entityId   String? @db.Uuid

  /// Metadonnees NON SENSIBLES uniquement (jamais de mot de passe, de hash,
  /// de secret de session ni de detail medical inutile — §24).
  metadata String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

// -----------------------------------------------------------------------------
//  PARAMETRES (§28) — cle/valeur, aucune donnee technique sensible
// -----------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// -----------------------------------------------------------------------------
//  FINANCES PRIVEES DU MEDECIN — entrees manuelles et depenses
// -----------------------------------------------------------------------------
//
//  Deux tables ADDITIVES, distinctes de `payments` :
//
//    - ManualIncome : argent recu HORS du circuit normal d'encaissement.
//      Elles ne doublent JAMAIS un paiement deja enregistre par l'application
//      de bureau : la prevention passe par la DISTINCTION des deux populations
//      dans les totaux (revenus calcules sur payments VALIDE d'un cote,
//      revenus manuels de l'autre), et par la regle d'usage documentee — une
//      encaissement clinique se saisit dans l'application de bureau.
//
//    - Expense : depenses du cabinet (materiel, fournitures, loyer...).
//
//  Aucune table existante n'est modifiee. Les montants restent des CENTIMES
//  ENTIERS, meme regle que les paiements.
// -----------------------------------------------------------------------------

model ManualIncome {
  id String @id @default(uuid()) @db.Uuid

  /// Montant en centimes. Strictement positif (verifie cote serveur).
  montantCentimes Int

  date DateTime

  /// Catégorie libre (ex. « location salle », « revente produit »).
  categorie String

  description String?
  notes       String?

  createdById String @db.Uuid
  createdBy   User   @relation("ManualIncomeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// Cle d'anti-doublon fournie par le formulaire : UNIQUE en base. Un second
  /// envoi du meme formulaire ne cree pas une seconde ligne, exactement comme
  /// la cle d'idempotence des paiements.
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([categorie])
  @@map("manual_incomes")
}

model Expense {
  id String @id @default(uuid()) @db.Uuid

  /// Montant en centimes. Strictement positif (verifie cote serveur).
  montantCentimes Int

  date DateTime

  /// Catégorie (EQUIPEMENT, FOURNITURES, LOYER, UTILITES, SALAIRES,
  /// MAINTENANCE, AUTRE — liste libre, validee cote serveur).
  categorie String

  description String?
  notes       String?

  createdById String @db.Uuid
  createdBy   User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// Cle d'anti-doublon fournie par le formulaire : UNIQUE en base.
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([categorie])
  @@map("expenses")
}

// -----------------------------------------------------------------------------
//  TRANSACTIONS PERSONNELLES DU MEDECIN — tres distinctes des finances du cabinet
// -----------------------------------------------------------------------------
//
//  Table ADDITIVE. Elle ne reagit JAMAIS avec :
//    - `payments` (paiements clinique enregistres par la secretaire) ;
//    - `manual_incomes` / `expenses` (finances du cabinet) ;
//    - les soldes patients (calcules sur traitements/paiements).
//
//  Une transaction personnelle appartient a UNE seule des trois natures :
//
//    - REVENUE      : argent personnel RECUT (+). Entre dans le solde personnel.
//    - DEPENSE      : argent personnel DEPENSE (-). Entre dans le solde personnel.
//    - DETTE_PERSONNELLE : argent personnellement DU (le medecin doit) ou DOU
//      (on lui doit), selon `direction`. N'entre JAMAIS dans le solde personnel :
//      ce n'est ni un revenu recu ni une depense effectuee.
//
//  La distinction direction/montant est explicite pour eviter toute convention
//  de signe cachee : le montant est toujours strictement positif, la lecture
//  depend uniquement de `nature` + `direction`.
// -----------------------------------------------------------------------------

model PersonalTransaction {
  id String @id @default(uuid()) @db.Uuid

  /// Montant en centimes, STRICTEMENT POSITIF (meme regle que les paiements).
  /// Le signe n'est jamais stocke : la lecture depend de `nature`.
  montantCentimes Int

  /// Nature de la transaction personnelle.
  nature PersonalNature

  /// Pour DETTE_PERSONNELLE uniquement : DO (le medecin doit a un tiers) ou
  /// DU_PAR_UN_TIERS (un tiers doit au medecin). IGNORE pour REVENUE/DEPENSE.
  direction PersonalDirection?

  /// Titre requis (ex. « Cadeau famille », « Remboursement laboratoire »).
  titre String

  date DateTime

  /// Note libre, optionnelle.
  note String?

  createdById String @db.Uuid
  createdBy   User   @relation("PersonalTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// Cle d'anti-doublon : UNIQUE en base, meme mecanisme que `payments` et
  /// `manual_incomes`. Un double envoi du formulaire ne cree pas deux lignes.
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([nature])
  @@index([createdById])
  @@map("personal_transactions")
}

enum PersonalNature {
  REVENUE
  DEPENSE
  DETTE_PERSONNELLE

  @@map("personal_nature")
}

enum PersonalDirection {
  /// Le medecin DOIT cet argent a un tiers.
  DO
  /// Un tiers DOIT cet argent au medecin.
  DU_PAR_UN_TIERS

  @@map("personal_direction")
}

// =============================================================================
//  SYNCHRONISATION OFFLINE-FIRST (Option B) — tables ADDITIVES
// =============================================================================
//  Ces tables supportent la synchronisation bidirectionnelle entre
//  l'application de bureau (base embarquee) et la base centrale Neon.
//  Aucune table existante n'est modifiee : voir la migration
//  20261101000000_sync_offline_first pour les details SQL (contraintes,
//  colonnes generees, index partiels).
// =============================================================================

/// Curseur de tirage (pull) par appareil et table metier. Persiste pour que
/// la reprise apres crash/panne reprenne EXACTEMENT ou elle s'etait arretee.
model SyncState {
  id           String    @id @default(uuid()) @db.Uuid
  deviceId     String    @db.Uuid
  tableName    String
  lastPulledAt DateTime  @default(now())
  lastPushedAt DateTime?

  @@unique([deviceId, tableName])
  @@index([deviceId])
  @@map("sync_state")
}

/// Idempotence stricte : un `operationId` donne ne peut produire d'effet
/// qu'une seule fois. Un rejeu (ack perdu, retry applicatif, crash) renvoie
/// `alreadyApplied = true` sans toucher aux donnees.
model SyncSeenOperation {
  operationId    String   @id @default(uuid()) @db.Uuid
  deviceId       String   @db.Uuid
  entityType     String
  receivedAt     DateTime @default(now())
  alreadyApplied Boolean  @default(false)

  @@index([deviceId])
  @@map("sync_seen_operations")
}

/// Journal serveur de la synchronisation (audit et diagnostic).
/// `outcome` : APPLIED | ALREADY_APPLIED | CONFLICT | REJECTED | REVOKED |
///             MIGRATION_BLOCKED.
model SyncEvent {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String   @db.Uuid
  operationId String?  @db.Uuid
  direction   String
  entityType  String
  entityId    String?  @db.Uuid
  outcome     String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([outcome, createdAt])
  @@map("sync_events")
}

/// Conflit conserve en DOUBLE version. Jamais resolu automatiquement pour
/// les donnees medicales ou financieres : `resolution` reste `PENDING`
/// jusqu'a un arbitrage humain journalise.
model SyncConflict {
  id               String    @id @default(uuid()) @db.Uuid
  entityType       String
  entityId         String    @db.Uuid
  fieldName        String?
  localValue       String?
  remoteValue      String?
  localUpdatedAt   DateTime?
  remoteUpdatedAt  DateTime?
  deviceId         String    @db.Uuid
  resolution       String    @default("PENDING")
  resolvedById     String?   @db.Uuid
  resolvedAt       DateTime?
  resolutionChoice String?
  archivedPayload  String?
  createdAt        DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([resolution])
  @@map("sync_conflicts")
}

/// Appairage et revocation des appareils. Le jeton n'est jamais stocke en
/// clair : uniquement son SHA-256. La revocation est verifiee DANS la
/// transaction de push (SELECT FOR SHARE) — jamais de course critique.
model DeviceSession {
  id                 String    @id @default(uuid()) @db.Uuid
  deviceId           String    @db.Uuid
  userId             String    @db.Uuid
  user               User      @relation("DeviceSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash          String    @unique
  recoveryPhraseHash String?
  recoverySalt       String?
  label              String?
  createdAt          DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  revokedAt          DateTime?
  revokedReason      String?

  @@index([deviceId])
  @@index([userId])
  @@map("device_sessions")
}

/// File d'attente LOCALE de l'appareil. Persistee en base embarquee :
/// survit a un crash, a un redemarrage et a une coupure secteur. Chaque
/// operation a un statut explicite : PENDING | SYNCING | SYNCHRONIZED |
/// CONFLICT | REJECTED. Une operation en echec NE BLOQUE PAS les suivantes.
model SyncQueueEntry {
  operationId    String    @id @default(uuid()) @db.Uuid
  deviceId       String    @db.Uuid
  entityType     String
  entityId       String    @db.Uuid
  operation      String
  payload        String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  lastError      String?
  conflictDetail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  synchronizedAt DateTime?

  @@index([status, createdAt])
  @@index([deviceId])
  @@map("sync_queue")
}

/// Journal DURABLE des suppressions (indépendant de la fenêtre 24 h).
/// Écrit dans la transaction de chaque suppression (corbeille, purge) ; un
/// RESTORE y ajoute une ligne qui annule le DELETE précédent. Rétention
/// pilotée par curseur : jamais purgé avant que chaque appareil actif ait lu.
model SyncTombstone {
  id            String   @id @default(uuid()) @db.Uuid
  entityType    String
  entityId      String   @db.Uuid
  /// DELETE = suppression ; RESTORE = restauration (annule le DELETE).
  type          String   @default("DELETE")
  sourceTrashId String?  @db.Uuid
  deviceId      String?
  deletedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([deletedAt])
  @@index([entityType, entityId])
  @@map("sync_tombstones")
}

/// Curseur de lecture des tombstones, par appareil. Un appareil récemment
/// appairé démarre à epoch (now - 100 ans) : il reçoit tout l'historique.
model SyncTombstoneCursor {
  id             String   @id @default(uuid()) @db.Uuid
  deviceId       String   @unique @db.Uuid
  lastTombstoneAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sync_tombstone_cursors")
}
